# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local configuration and secrets
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
scripts/work/.runtime/

# Local geospatial inputs and generated products. Directory marker files remain
# tracked; manifests and deliberately small test fixtures may be force-added.
/data/raw/**/*
/data/converted/**/*
/data/native/**/*
/data/standard/**/*
/data/work/**/*
/data/model/**/*
/data/output/**/*
!/data/raw/**/
!/data/converted/**/
!/data/native/**/
!/data/standard/**/
!/data/work/**/
!/data/**/.gitkeep

# Large geospatial formats outside the lifecycle directories
*.las
*.laz
*.tif
*.tiff
*.gml
*.gpkg
*.shp
*.shx
*.dbf
*.vrt
*.copc
*.tmp
*.temp

# GIS application scratch and lock files
*.qgs~
*.qgz~
*.gpkg-wal
*.gpkg-shm
